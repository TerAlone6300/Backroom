<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" /> <!-- open the system installer for the downloaded update -->

    <application
        android:label="Backrooms"
        android:icon="@drawable/ic_launcher_logo"
        android:roundIcon="@drawable/ic_launcher_logo"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- hands the downloaded update.apk (in our cache) to the system installer -->
        <provider
            android:name=".UpdateProvider"
            android:authorities="${applicationId}.update"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>

</manifest>